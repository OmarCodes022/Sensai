        </mxCell>
        <mxCell id="strategy-39" value="B1 local Ollama HTTP chatbot exists today. Everything else below is a proposed extension." style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontColor=#536078;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1012" y="422" width="950" height="72" as="geometry" />
        </mxCell>
        <mxCell id="strategy-40" value="&lt;b&gt;Conversation + personas  [A5]&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;B1 chat; M1 saved creator sessions; M2 context budget. X1 UI, X2 branch/interrupt, X4 clarification form. Change personas without losing history.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#315FCE;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="850" y="565" width="540" height="208" as="geometry" />
        </mxCell>
        <mxCell id="strategy-41" value="&lt;b&gt;Creator's brand knowledge  [R1]&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;M3 structured facts; R1 vector retrieval; R2 filtering/rerank if needed. T4 permission-scoped files keep brand data private.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#315FCE;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="1450" y="565" width="540" height="208" as="geometry" />
        </mxCell>
        <mxCell id="strategy-42" value="&lt;b&gt;Research + analytics  [A1]&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;T2 sandboxed CSV code; T3 live trends; bounded A1 reasoning. T1 MCP and A2 specialist agents only when justified.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#315FCE;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="850" y="830" width="540" height="208" as="geometry" />
        </mxCell>
        <mxCell id="strategy-43" value="&lt;b&gt;Four drafts + living report  [M4]&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;Post drafts, DM replies, weekly performance report and content calendar. T5 structured edits; A4 prompt versions and A6 scoped cache if useful. A7 automatic optimization is a stretch goal.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#315FCE;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="1450" y="830" width="540" height="208" as="geometry" />
        </mxCell>
        <mxCell id="strategy-44" value="&lt;b&gt;Check evidence, privacy and reliability&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;EV1 scores source faithfulness; EV2 checks input/output privacy; EV3 monitors latency and tokens; EV4 attacks the system with test fixtures.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#315FCE;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="850" y="1095" width="1140" height="188" as="geometry" />
        </mxCell>
        <mxCell id="strategy-45" value="&lt;b&gt;Creator-private brand workspace&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;Session/profile + brand facts + source index + four saved drafts. Research, drafting and private export may run automatically; the creator controls public sharing.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#7554BC;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="850" y="1330" width="1140" height="195" as="geometry" />
        </mxCell>
        <mxCell id="strategy-46" value="&lt;b&gt;1  POST DRAFTS&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;Skincare posts in the creator's chosen brand voice, grounded in approved facts.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#315FCE;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="2090" y="340" width="675" height="172" as="geometry" />
        </mxCell>
        <mxCell id="strategy-47" value="&lt;b&gt;2  DM REPLY SUGGESTIONS&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;Draft answers to anonymized audience questions; never sent automatically.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#315FCE;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="2090" y="528" width="675" height="172" as="geometry" />
        </mxCell>
        <mxCell id="strategy-48" value="&lt;b&gt;3  WEEKLY PERFORMANCE REPORT&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;Engagement analysis, cited brand/trend insights and next actions.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#315FCE;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="2090" y="716" width="675" height="172" as="geometry" />
        </mxCell>
        <mxCell id="strategy-49" value="&lt;b&gt;4  PROPOSED CONTENT CALENDAR&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;Post ideas, intended dates and channels; X5 schedules drafts, not publication.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#315FCE;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="2090" y="904" width="675" height="172" as="geometry" />
        </mxCell>
        <mxCell id="strategy-50" value="&lt;b&gt;AUTOMATIC PRIVATE EXPORT  [X3]&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;After EV2 checks, save/download all four outputs locally. No public link or send.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#315FCE;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="2090" y="1100" width="675" height="134" as="geometry" />
        </mxCell>
        <mxCell id="strategy-51" value="&lt;b&gt;PUBLIC SHARE / SEND APPROVAL  [A3]&lt;/b&gt;&lt;br&gt;&lt;font color='#536078'&gt;Only for external sends, publication or a public link: show exact content and destination; reject keeps the private draft. No live connector in the first demo.&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#AF671E;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="2090" y="1260" width="675" height="277" as="geometry" />
        </mxCell>
        <mxCell id="strategy-52" value="brief + voice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#277D75;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#277D75;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="strategy-13" target="strategy-36">
