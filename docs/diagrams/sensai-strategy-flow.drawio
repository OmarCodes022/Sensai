        <mxCell id="strategy-38" value="SENSAI  |  your strategy assistant" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=31;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
