# Copy to .env, then choose one Ollama configuration. Real environment variables take precedence.
# Local Ollama:
OLLAMA_HOST=http://localhost:11434
SENSAI_MODEL=gemma3:1b
SENSAI_SSH_HOST=
# Remote Ollama via SSH (comment out the three local values above and uncomment these):
# OLLAMA_HOST=http://127.0.0.1:11435
# SENSAI_MODEL=qwen3.5:9b-q4_K_M
# SENSAI_SSH_HOST=sensai-windows
# See docs/operations/remote-ollama.md for SSH setup and the launcher command.
# Optional prompt file; unset uses the packaged default prompt.
# SENSAI_PROMPT=my-prompt.txt
# Optional startup persona: redaction, communaute or analyse. Unset keeps the usual assistant.
# SENSAI_PERSONA=redaction
# Optional JSON catalogue replacing all built-in profiles.
# SENSAI_PERSONAS_FILE=personas.local.json
# Saved sessions (SQLite, default ./sensai.sqlite3), creator scope and optional profile JSON.
# SENSAI_DB=sensai.sqlite3
# SENSAI_CREATOR=default
# SENSAI_PROFILE_FILE=profil.local.json
# Optional folder whose top-level files are copied into each run_python sandbox run.
# SENSAI_DATA_DIR=data   # default: ./data when it exists; set empty to switch the data folder off
SENSAI_TIMEOUT=60
# Brand documents the model searches (.md and .txt). Default ./data/docs; set empty to switch search off.
# SENSAI_DOCS=data/docs
# Ollama embedding model used to index and search the documents (ollama pull nomic-embed-text).
# SENSAI_EMBED_MODEL=nomic-embed-text
# Optional context token budget for prompt and generation; larger values use more VRAM.
# SENSAI_CONTEXT_LENGTH=8192
# Complete turn budget, including initial connection and all chunks.
SENSAI_OPERATION_TIMEOUT=120
SENSAI_TEST_MODEL=gemma3:1b
