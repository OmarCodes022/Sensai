# Copy to .env, then choose one Ollama configuration. Real environment variables take precedence.
# Local Ollama:
OLLAMA_HOST=http://localhost:11434
SENSAI_MODEL=gemma3:1b
SENSAI_SSH_HOST=
# Remote Ollama via SSH (comment out the three local values above and uncomment these):
# OLLAMA_HOST=http://127.0.0.1:11435
# SENSAI_MODEL=qwen3.5:9b-q4_K_M
# SENSAI_SSH_HOST=sensai-windows
# See docs/operations/remote-ollama.md for SSH setup and the launcher command.
SENSAI_PROMPT=prompts/system.txt
# Optional startup persona: redaction, communaute or analyse. Unset keeps the usual assistant.
# SENSAI_PERSONA=redaction
# Optional JSON catalogue replacing all built-in profiles.
# SENSAI_PERSONAS_FILE=personas.local.json
SENSAI_TIMEOUT=60
# Complete turn budget, including initial connection and all chunks.
SENSAI_OPERATION_TIMEOUT=120
SENSAI_TEST_MODEL=gemma3:1b
