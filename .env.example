# Copy to .env and edit. Real environment variables take precedence.
OLLAMA_HOST=http://localhost:11434
SENSAI_MODEL=gemma3:1b
SENSAI_PROMPT=prompts/system.txt
# Optional startup persona: redaction, communaute or analyse. Unset keeps the usual assistant.
# SENSAI_PERSONA=redaction
# Optional JSON catalogue replacing all built-in profiles.
# SENSAI_PERSONAS_FILE=personas.local.json
SENSAI_TIMEOUT=60
# Complete turn budget, including initial connection and all chunks.
SENSAI_OPERATION_TIMEOUT=120
SENSAI_TEST_MODEL=gemma3:1b
